+/**
+ * Generates an image through a user-configured OpenAI-compatible relay.
+ * The request stays on the SillyTavern host so mobile WebViews do not need
+ * CORS access to the relay.
+ */
+async function generateOpenAiCompatibleImage(prompt, signal) {
+    const apiUrl = String(extension_settings.sd.openai_compatible_url || '').trim();
+    const apiKey = String(extension_settings.sd.openai_compatible_key || '').trim();
+    const model = String(extension_settings.sd.openai_compatible_model || extension_settings.sd.model || '').trim();
+    if (!apiUrl) throw new Error('OpenAI-compatible image API URL is not set.');
+    if (!apiKey) throw new Error('OpenAI-compatible API key is not set.');
+    if (!model) throw new Error('OpenAI-compatible image model is not set.');
+
+    const result = await fetch('/api/openai/generate-image', {
+        method: 'POST',
+        headers: getRequestHeaders(),
+        signal,
+        body: JSON.stringify({
+            api_url: apiUrl,
+            api_key: apiKey,
+            prompt,
+            model,
+            size: `${extension_settings.sd.width}x${extension_settings.sd.height}`,
+            n: 1,
+            response_format: 'b64_json',
+        }),
+    });
+    if (!result.ok) throw new Error(await result.text() || 'OpenAI-compatible relay returned an error.');
+
+    const payload = await result.json();
+    const item = Array.isArray(payload?.data)
+        ? payload.data[0]
+        : Array.isArray(payload?.images)
+            ? payload.images[0]
+            : payload?.data;
+    const imageData = item?.b64_json || item?.base64 || item?.image
+        || (typeof item === 'string' && !/^https?:\/\//i.test(item) ? item : '');
+    if (imageData) return { format: 'png', data: String(imageData).replace(/^data:image\/[^;]+;base64,/, '') };
+    const imageUrl = typeof item === 'string' && /^https?:\/\//i.test(item) ? item : item?.url;
+    if (typeof imageUrl === 'string' && /^https?:\/\//i.test(imageUrl)) {
+        const imageResponse = await fetch(imageUrl, { signal });
+        if (!imageResponse.ok) throw new Error('Could not download the generated image URL.');
+        const dataUrl = await getBase64Async(await imageResponse.blob());
+        return { format: 'png', data: dataUrl.split(',')[1] || '' };
+    }
+    throw new Error('OpenAI-compatible relay returned no image data.');
+}
